import { defineConfig, type UserConfig } from 'tsdown';

const common: UserConfig = {
  entry: ['package/index.ts'],
  outDir: 'dist',
  tsconfig: 'scripts/tsconfig.build.json',
  platform: 'neutral',
  target: 'esnext',
  minify: true,
  sourcemap: true,
  clean: false,
  // Only a type is imported from `@hello-pangea/dnd` (a dev dependency), so keep it external
  // instead of letting the declaration bundler try to inline its types
  deps: { neverBundle: ['@hello-pangea/dnd'] },
  // `'use client'` in package/index.ts is kept at the top of each bundle (single entry, single chunk)
  inputOptions: { checks: { moduleLevelDirective: false } },
};

export default defineConfig([
  {
    ...common,
    format: 'esm',
    // `isolatedDeclarations` is enabled in the build tsconfig, so declarations are
    // generated by Oxc and the TypeScript compiler API is not needed at all
    dts: { generator: 'oxc' },
    outExtensions: () => ({ js: '.mjs', dts: '.d.ts' }),
  },
  {
    ...common,
    format: 'cjs',
    dts: false,
    outExtensions: () => ({ js: '.js' }),
  },
]);
